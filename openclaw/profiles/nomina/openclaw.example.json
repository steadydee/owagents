{
  "env": {
    "vars": {
      "OWLSWATCH_PAYROLL_WORKSPACE": "<absolute-private-payroll-workspace>",
      "OWLSWATCH_PAYROLL_PYTHON": "<absolute-private-payroll-workspace>/.venv/bin/python3"
    }
  },
  "agents": {
    "defaults": {
      "workspace": "~/.openclaw/workspace-nomina-nomina",
      "skills": [
        "payroll"
      ],
      "models": {
        "openai/gpt-5.4-mini": {
          "agentRuntime": {
            "id": "openclaw"
          },
          "params": {
            "transport": "sse",
            "maxTokens": 4096,
            "thinking": "low"
          }
        },
        "deepseek/deepseek-flash": {
          "params": {
            "thinking": "high"
          }
        }
      },
      "model": {
        "primary": "deepseek/deepseek-flash",
        "fallbacks": [
          "openai/gpt-5.4-mini"
        ]
      },
      "heartbeat": {
        "every": "0m"
      },
      "timeoutSeconds": 180
    },
    "list": [
      {
        "id": "nomina",
        "name": "N\u00f3mina",
        "default": true,
        "workspace": "~/.openclaw/workspace-nomina-nomina",
        "agentDir": "~/.openclaw-nomina/agents/nomina/agent",
        "skills": [
          "payroll"
        ],
        "tools": {
          "profile": "minimal",
          "alsoAllow": [
            "nomina_status",
            "nomina_list_payees",
            "nomina_get_loans",
            "nomina_prepare_change",
            "nomina_prepare_run",
            "nomina_adjust_draft",
            "nomina_get_run",
            "nomina_prepare_finalize",
            "nomina_prepare_paid",
            "nomina_prepare_supersede",
            "nomina_prepare_reverse_payment",
            "nomina_history",
            "nomina_export",
            "nomina_archive_status"
          ],
          "deny": [
            "exec",
            "browser",
            "gateway",
            "cron",
            "nodes",
            "canvas",
            "group:fs",
            "group:web",
            "bundle-mcp",
            "message"
          ]
        },
        "model": {
          "primary": "deepseek/deepseek-flash",
          "fallbacks": [
            "openai/gpt-5.4-mini"
          ]
        },
        "models": {
          "openai/gpt-5.4-mini": {
            "agentRuntime": {
              "id": "openclaw"
            },
            "params": {
              "transport": "sse",
              "maxTokens": 4096,
              "thinking": "low"
            }
          },
          "deepseek/deepseek-flash": {
            "params": {
              "thinking": "high"
            }
          }
        }
      }
    ]
  },
  "gateway": {
    "mode": "local",
    "port": 19231,
    "bind": "loopback",
    "channelHealthCheckMinutes": 1,
    "channelStaleEventThresholdMinutes": 5,
    "channelMaxRestartsPerHour": 6,
    "auth": {
      "mode": "token",
      "token": "<generate-locally>"
    }
  },
  "plugins": {
    "entries": {
      "owlswatch-payroll": {
        "enabled": true,
        "hooks": {
          "allowConversationAccess": true
        }
      },
      "owlswatch-runtime-guard": {
        "enabled": true,
        "hooks": {
          "allowConversationAccess": true
        }
      },
      "openai": {
        "enabled": true
      },
      "deepseek": {
        "enabled": true
      }
    },
    "load": {
      "paths": [
        "~/.openclaw/workspace-nomina-nomina/tools/owlswatch_payroll/openclaw-plugin.js",
        "~/.openclaw/workspace-nomina-nomina/tools/agent_runtime_guard/openclaw-plugin.js"
      ]
    }
  },
  "channels": {
    "telegram": {
      "enabled": false,
      "botToken": "<set-locally-only>",
      "healthMonitor": {
        "enabled": true
      },
      "dmPolicy": "allowlist",
      "allowFrom": [
        "0"
      ],
      "groupPolicy": "disabled",
      "groupAllowFrom": [],
      "groups": {},
      "streaming": {
        "mode": "off",
        "preview": {
          "toolProgress": false
        },
        "progress": {
          "label": false,
          "toolProgress": false,
          "maxLines": 1
        },
        "block": {
          "enabled": false
        }
      }
    }
  },
  "session": {
    "dmScope": "per-channel-peer"
  },
  "tools": {
    "loopDetection": {
      "enabled": true,
      "historySize": 30,
      "warningThreshold": 4,
      "criticalThreshold": 8,
      "globalCircuitBreakerThreshold": 12,
      "unknownToolThreshold": 3,
      "detectors": {
        "genericRepeat": true,
        "knownPollNoProgress": true,
        "pingPong": true
      }
    }
  },
  "models": {
    "providers": {
      "openai": {
        "baseUrl": "https://api.openai.com/v1",
        "api": "openai-responses",
        "auth": "api-key",
        "agentRuntime": {
          "id": "openclaw"
        },
        "timeoutSeconds": 60,
        "apiKey": {
          "source": "env",
          "provider": "openai-fallback-env",
          "id": "OPENAI_FALLBACK_API_KEY"
        },
        "models": [
          {
            "id": "gpt-5.4-mini",
            "name": "GPT-5.4 mini",
            "reasoning": true,
            "input": [
              "text",
              "image"
            ],
            "contextWindow": 400000,
            "contextTokens": 65536,
            "maxTokens": 4096,
            "cost": {
              "input": 0.75,
              "output": 4.5,
              "cacheRead": 0.075,
              "cacheWrite": 0
            }
          }
        ]
      },
      "deepseek": {
        "baseUrl": "https://api.deepseek.com",
        "api": "openai-completions",
        "timeoutSeconds": 30,
        "models": [
          {
            "id": "deepseek-flash",
            "name": "DeepSeek Flash",
            "reasoning": true,
            "input": [
              "text",
              "image"
            ],
            "contextWindow": 1000000,
            "contextTokens": 65536,
            "maxTokens": 8192,
            "cost": {
              "input": 0.3,
              "output": 1.2,
              "cacheRead": 0.006,
              "cacheWrite": 0
            }
          }
        ]
      }
    }
  },
  "secrets": {
    "providers": {
      "openai-fallback-env": {
        "source": "env",
        "allowlist": [
          "OPENAI_FALLBACK_API_KEY"
        ]
      }
    }
  }
}
